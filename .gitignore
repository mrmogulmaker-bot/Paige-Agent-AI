# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code local session state (settings + agent worktrees) — never commit,
# but DO version shared project commands under .claude/commands/ so every session
# (and every teammate) gets them.
.claude/*
!.claude/commands/

# Live-drive helper screenshot artifacts — rendered PNGs are never committed (may contain
# authed-surface pixels); credentials are ENV-only and never written to disk. (scripts/live-drive)
scripts/live-drive/artifacts/
deno.lock

# Rendered pack/app screenshots — regenerate with scripts/live-drive/pack-shoot.mjs
scripts/live-drive/artifacts/

# Harness scratch — one-off diagnostic scripts a render pass writes while it is running.
# Not deliverables: the harness's real outputs are its assertions and its labelled frames,
# and its frames already land in scripts/live-drive/artifacts/ above.
scripts/live-drive/harness/tmp/
# Same rule, at the repo root: a review agent probing a live harness has to run its script
# from inside the repo, because node module resolution fails from /tmp. Without this the probe
# leaves the tree dirty and the next commit is one keystroke from carrying throwaway code.
scratch-*.mjs
